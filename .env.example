# Copy to .env and set every empty secret before starting Docker Compose.
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=foodai
POSTGRES_DB=foodai
POSTGRES_PASSWORD=

# Minimum 32 characters; sample values are rejected outside development/test.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_HASHER=argon2id

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TEXT_TIMEOUT_SECONDS=30
OPENAI_TEXT_MAX_ATTEMPTS=2
OPENAI_RESPONSE_SCHEMA_VERSION=2
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
# Storage/mobile format after optimize (webp|jpeg). Not sent to OpenAI.
OPENAI_IMAGE_FORMAT=webp
# Wire format for Images API (png|jpeg|webp). png is the safest GPT Image default.
OPENAI_IMAGE_PROVIDER_FORMAT=png
OPENAI_IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_RETRIES=3
IMAGE_MAX_CONCURRENT_JOBS=

S3_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=foodai-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
S3_PRESIGNED_URL_TTL_SECONDS=300
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

NUTRITION_MIN_DAILY_CALORIES_FEMALE=1200
NUTRITION_MIN_DAILY_CALORIES_MALE=1500
# Empty means 1.0 kg per week.
NUTRITION_MAX_WEEKLY_WEIGHT_CHANGE_KG=
# Empty means the built-in factors; a JSON object overrides them per activity level.
NUTRITION_ACTIVITY_FACTORS_JSON=
AI_CACHE_TTL_SECONDS=86400
AI_RATE_LIMIT_FREE_PER_DAY=
AI_RATE_LIMIT_PREMIUM_PER_DAY=

# Free-tier daily windows (Premium unlimited when ENTITLEMENT_PREMIUM_DAILY_LIMIT empty).
ENTITLEMENT_FREE_MEAL_PLAN_PER_DAY=10
ENTITLEMENT_FREE_MEAL_REPLACE_PER_DAY=15
ENTITLEMENT_FREE_CHAT_PER_DAY=40
ENTITLEMENT_FREE_DEFAULT_PER_DAY=20
ENTITLEMENT_PREMIUM_DAILY_LIMIT=

# Phase 17 — legal, consent, admin bootstrap, nutrition policy
TERMS_URL=https://example.com/terms
PRIVACY_URL=https://example.com/privacy
TERMS_VERSION=v1
PRIVACY_VERSION=v1
ADMIN_EMAILS=
EMAIL_PROVIDER=mock
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
PUBLIC_APP_BASE_URL=https://example.com
NUTRITION_POLICY_VERSION=v1

# Text AI — DeepSeek is the exclusive product text provider (Phase 21).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_TEXT_TIMEOUT_SECONDS=60

# OpenAI — vision (food photo) + image generation only. Not used for product text.
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_TIMEOUT_SECONDS=60
OPENAI_VISION_MAX_IMAGE_BYTES=5242880
OPENAI_VISION_MAX_DIMENSION=2048
ENTITLEMENT_FREE_FOOD_PHOTO_PER_DAY=10
