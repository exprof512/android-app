# Copy to .env and set every empty secret before starting Docker Compose.
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=foodai
POSTGRES_DB=foodai
POSTGRES_PASSWORD=

# Minimum 32 characters; sample values are rejected outside development/test.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_HASHER=argon2id

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TEXT_TIMEOUT_SECONDS=30
OPENAI_TEXT_MAX_ATTEMPTS=2
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_QUALITY=
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_TIMEOUT_SECONDS=60
IMAGE_MAX_RETRIES=3
IMAGE_MAX_CONCURRENT_JOBS=

S3_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=foodai-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
S3_PRESIGNED_URL_TTL_SECONDS=300
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

NUTRITION_MIN_DAILY_CALORIES_FEMALE=1200
NUTRITION_MIN_DAILY_CALORIES_MALE=1500
# Empty means 1.0 kg per week.
NUTRITION_MAX_WEEKLY_WEIGHT_CHANGE_KG=
# Empty means the built-in factors; a JSON object overrides them per activity level.
NUTRITION_ACTIVITY_FACTORS_JSON=
AI_CACHE_TTL_SECONDS=86400
AI_RATE_LIMIT_FREE_PER_DAY=
AI_RATE_LIMIT_PREMIUM_PER_DAY=
